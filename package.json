{
  "name": "pak-na-pak",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/customer",
    "apps/admin",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @pak-na-pak/customer",
    "build": "npm run build --workspace @pak-na-pak/customer",
    "start": "npm run start --workspace @pak-na-pak/customer",
    "dev:customer": "npm run dev --workspace @pak-na-pak/customer",
    "build:customer": "npm run build --workspace @pak-na-pak/customer",
    "start:customer": "npm run start --workspace @pak-na-pak/customer",
    "dev:admin": "npm run dev --workspace @pak-na-pak/admin",
    "build:admin": "npm run build --workspace @pak-na-pak/admin",
    "start:admin": "npm run start --workspace @pak-na-pak/admin",
    "test:workspace": "node --test tests/workspace-boundaries.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^5"
  }
}
